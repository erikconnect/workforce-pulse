# =============================================================================
# Workforce Pulse Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env or any file containing secrets.
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/workforce-pulse
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/workforce-pulse

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
# For production: https://your-frontend-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Bright Data Configuration (for backend scraping)
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_BROWSER_WSS=

# USAJOBS API
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=your-email@example.com

# JobAps RSS
JOBAPS_RSS_URL=https://jobapscloud.com/MGM/rss.asp

# Logging
LOG_LEVEL=info
