{
  "crons": [
    {
      "path": "/api/jobs/aggregate",
      "schedule": "0 0 * * *"
    }
  ],
  "env": {
    "MONGODB_URI": "@mongodb_uri"
  },
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/jobs/aggregate/route.ts": {
      "maxDuration": 120
    }
  }
}
